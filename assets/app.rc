#include <winver.h>

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_COMMA
 PRODUCTVERSION VER_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "FileDescription", "FrameScope - Videoplayer fuer frame-genaue Analyse"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "framescope"
            VALUE "OriginalFilename", "framescope.exe"
            VALUE "ProductName", "FrameScope"
            VALUE "ProductVersion", VER_STR
            VALUE "LegalCopyright", "Copyright (c) 2026 supaeasy - Verkauf nur mit Genehmigung (siehe LICENSE)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
